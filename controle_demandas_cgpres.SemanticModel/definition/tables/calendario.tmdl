table calendario
	lineageTag: 89aa5724-18e0-5d65-8d3d-d9cdf5286751
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 37d7af63-83b5-542b-880f-dd6dd18a5c19
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

		annotation SummarizationSetBy = Automatic

	column Mês
		dataType: dateTime
		formatString: mmm/yyyy
		lineageTag: 9d854f90-f930-5056-8e6f-39532bbd705e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês]

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 9b14c429-2d19-5bc6-82f9-f490e05a0384
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	partition calendario = calculated
		mode: import
		source =
				VAR _inicio = DATE ( YEAR ( MIN ( 'diligencias'[dataRecebimento] ) ), 1, 1 )
				VAR _fim = DATE ( YEAR ( MAX ( MAX ( 'diligencias'[prazoExterno] ), TODAY () ) ), 12, 31 )
				RETURN
				    SELECTCOLUMNS (
				        CALENDAR ( _inicio, _fim ),
				        "Data", [Date],
				        "Mês", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				        "Ano", YEAR ( [Date] )
				    )


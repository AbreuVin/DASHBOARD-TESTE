	column 'Situação do prazo' =
			VAR _entrega = 'diligencias'[dataEntrega]
			VAR _limite = 'diligencias'[prazoExterno]
			RETURN
			    IF (
			        NOT ISBLANK ( _entrega ),
			        IF ( _entrega <= _limite, "Entregue no prazo", "Entregue com atraso" ),
			        IF ( TODAY () <= _limite, "Em andamento no prazo", "Em andamento com prazo vencido" )
			    )
		dataType: string
		displayFolder: Prazos
		lineageTag: be0080b7-5320-52f8-a224-33f0ecf26274
		summarizeBy: none
		sortByColumn: 'Situação do prazo (ordem)'

		annotation SummarizationSetBy = Automatic

	column 'Situação do prazo (ordem)' =
			SWITCH (
			    'diligencias'[Situação do prazo],
			    "Entregue no prazo", 1,
			    "Entregue com atraso", 2,
			    "Em andamento no prazo", 3,
			    4
			)
		dataType: int64
		formatString: 0
		isHidden
		displayFolder: Prazos
		lineageTag: 23c0413f-6f58-59d2-b1fe-2fb5e8ad25d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cumprimento do prazo' =
			IF (
			    'diligencias'[Situação do prazo] IN { "Entregue no prazo", "Em andamento no prazo" },
			    "Dentro do prazo",
			    "Fora do prazo"
			)
		dataType: string
		displayFolder: Prazos
		lineageTag: 209b6e29-3026-51fe-9bd0-6d0f6da9f861
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Status' =
			IF ( ISBLANK ( 'diligencias'[dataEntrega] ), "Em tramitação", "Finalizada" )
		dataType: string
		displayFolder: Prazos
		lineageTag: dd86bd21-2d42-52de-a69b-d4fdc7072680
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Prazo interno cumprido' =
			IF (
			    ISBLANK ( 'diligencias'[dataEntrega] ),
			    BLANK (),
			    IF ( 'diligencias'[dataEntrega] <= 'diligencias'[prazoInterno], "Sim", "Não" )
			)
		dataType: string
		displayFolder: Prazos
		lineageTag: bfde54f8-fb7e-5345-bedd-43f33856a590
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dias de atraso' =
			VAR _referencia =
			    IF ( ISBLANK ( 'diligencias'[dataEntrega] ), TODAY (), 'diligencias'[dataEntrega] )
			VAR _dias = INT ( _referencia ) - INT ( 'diligencias'[prazoExterno] )
			RETURN
			    IF ( _dias > 0, _dias, BLANK () )
		dataType: int64
		formatString: #,##0
		displayFolder: Prazos
		lineageTag: cc75296e-7b99-502b-9bf1-f2590c1d3fcd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


table diligencias
	lineageTag: 2e064285-cebd-5068-af06-506e3f3140ac

	measure 'Diligências recebidas' = COUNTROWS ( 'diligencias' )
		formatString: #,##0
		displayFolder: Indicadores
		lineageTag: b3d6c31d-5bdb-5dc9-8314-18432162d635

	measure 'Finalizadas' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Status] = "Finalizada" )
		formatString: #,##0
		displayFolder: Indicadores
		lineageTag: cc84c660-51ef-536f-a6b3-cb49f72ad4d8

	measure 'Em tramitação' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Status] = "Em tramitação" )
		formatString: #,##0
		displayFolder: Indicadores
		lineageTag: 5ab82c14-2819-5442-afb3-900fb1eb44d7

	measure 'Entregue no prazo' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Situação do prazo] = "Entregue no prazo" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: 68276ff9-8085-540a-b28f-8a5173f189ad

	measure 'Entregue com atraso' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Situação do prazo] = "Entregue com atraso" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: 46594523-072c-5f94-8674-8a9429f23946

	measure 'Em andamento no prazo' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Situação do prazo] = "Em andamento no prazo" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: e0afd9ba-a791-5111-8a78-09880482520b

	measure 'Em andamento com prazo vencido' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Situação do prazo] = "Em andamento com prazo vencido" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: b38dab01-86fa-5d76-a2db-a3b7a1ea88e5

	measure 'Dentro do prazo' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Cumprimento do prazo] = "Dentro do prazo" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: d1d1842e-8fdd-571b-9dfc-5433572b8b6b

	measure 'Fora do prazo' = CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Cumprimento do prazo] = "Fora do prazo" )
		formatString: #,##0
		displayFolder: Situação do prazo
		lineageTag: be148bdd-5a24-5708-bee3-da14a5c1c866

	measure '% entregue no prazo' = DIVIDE ( [Entregue no prazo], [Finalizadas] )
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: f35c0b96-ab7a-5126-a4e9-09875e9d9fd9

	measure '% entregue no prazo interno' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'diligencias' ), 'diligencias'[Prazo interno cumprido] = "Sim" ),
			    [Finalizadas]
			)
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: edead8ed-4ff5-59e8-b98e-4470aefc3d22

	measure 'Vencem nos próximos 7 dias' =
			VAR _hoje = TODAY ()
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'diligencias' ),
			        'diligencias'[Status] = "Em tramitação",
			        'diligencias'[prazoExterno] >= _hoje && 'diligencias'[prazoExterno] <= _hoje + 7
			    )
		formatString: #,##0
		displayFolder: Indicadores
		lineageTag: 8af79a78-7319-5fb9-bcaf-5f7bf6690b7c

	measure 'Finalizadas no mês' =
			CALCULATE (
			    [Finalizadas],
			    USERELATIONSHIP ( 'calendario'[Data], 'diligencias'[dataEntrega] )
			)
		formatString: #,##0
		displayFolder: Metas
		lineageTag: b06563d8-fe61-55fd-a718-5ccad9991971

	measure 'Entregues no prazo no mês' =
			CALCULATE (
			    [Entregue no prazo],
			    USERELATIONSHIP ( 'calendario'[Data], 'diligencias'[dataEntrega] )
			)
		formatString: #,##0
		displayFolder: Metas
		lineageTag: b566e690-a169-54ff-a015-00a1a6449449

	measure '% no prazo no mês' = DIVIDE ( [Entregues no prazo no mês], [Finalizadas no mês] )
		formatString: 0.0%
		displayFolder: Metas
		lineageTag: 6ed03c5a-e998-5ad7-aea3-61e7d5b642f8

	measure 'Meta de finalizadas' =
			SUMX (
			    VALUES ( 'calendario'[Mês] ),
			    LOOKUPVALUE ( 'metas'[metaFinalizadas], 'metas'[mes], 'calendario'[Mês] )
			)
		formatString: #,##0
		displayFolder: Metas
		lineageTag: 3c3261e7-35d3-5c56-be7d-099905fb784d

	measure 'Meta % no prazo' =
			AVERAGEX (
			    VALUES ( 'calendario'[Mês] ),
			    LOOKUPVALUE ( 'metas'[metaPercNoPrazo], 'metas'[mes], 'calendario'[Mês] )
			)
		formatString: 0.0%
		displayFolder: Metas
		lineageTag: b309ed76-690f-5036-a744-36e3eb75726e

	measure 'Atingimento da meta' = DIVIDE ( [Finalizadas no mês], [Meta de finalizadas] )
		formatString: 0.0%
		displayFolder: Metas
		lineageTag: dc7ae127-c523-5814-95f5-4033d012b02e

	measure 'Destaque' =
			VAR _vencidas = [Em andamento com prazo vencido] + 0
			VAR _semana = [Vencem nos próximos 7 dias] + 0
			VAR _t1 =
			    IF (
			        _vencidas = 1,
			        "1 diligência em andamento já passou do prazo externo",
			        FORMAT ( _vencidas, "0" ) & " diligências em andamento já passaram do prazo externo"
			    )
			VAR _t2 =
			    IF (
			        _semana = 1,
			        "1 vence nos próximos 7 dias",
			        FORMAT ( _semana, "0" ) & " vencem nos próximos 7 dias"
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        _vencidas = 0 && _semana = 0, "Nenhuma diligência em andamento está vencida ou vence nos próximos 7 dias.",
			        _vencidas = 0, "Nenhuma diligência em andamento está vencida; " & _t2 & ".",
			        _t1 & "; " & _t2 & "."
			    )
		displayFolder: Textos
		lineageTag: 761da62b-10a9-5a1f-b29f-ac575006195e

	measure 'Atualização dos dados' =
			VAR _ultima =
			    CALCULATE ( MAX ( 'diligencias'[dataRecebimento] ), REMOVEFILTERS () )
			RETURN
			    "Última diligência recebida em " & FORMAT ( _ultima, "dd/mm/yyyy" )
		displayFolder: Textos
		lineageTag: 39d94f49-9836-53ec-b3c1-ddc70a9963c4

	measure 'Cor da situação' =
			SWITCH (
			    SELECTEDVALUE ( 'diligencias'[Situação do prazo] ),
			    "Entregue no prazo", "#247B50",
			    "Entregue com atraso", "#92400E",
			    "Em andamento no prazo", "#1F4E8C",
			    "Em andamento com prazo vencido", "#B42318",
			    "#5F6368"
			)
		displayFolder: Textos
		lineageTag: 1b4d59d1-a703-5b27-b7b3-00e1e6f09dd8


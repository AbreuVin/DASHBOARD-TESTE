table _Medidas
	lineageTag: d6b61d2a-2f73-4b5d-9a15-3bbf2d5e6f10

	measure 'Total Instrumentos' = COUNTROWS('instrumentos')
		formatString: #,##0
		displayFolder: 01 KPIs
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b001

	measure 'Instrumentos Vigentes' = CALCULATE(
		COUNTROWS('instrumentos'),
		FILTER(
			'instrumentos',
			ISBLANK('instrumentos'[dataFimVigenciaEfetiva]) || 'instrumentos'[dataFimVigenciaEfetiva] >= TODAY()
		)
	)
		formatString: #,##0
		displayFolder: 01 KPIs
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b002

	measure 'Total Aditivos' = COUNTROWS('aditivos')
		formatString: #,##0
		displayFolder: 01 KPIs
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b003

	measure 'Partícipes Vinculados' = COUNTROWS('participesInstrumentos')
		formatString: #,##0
		displayFolder: 01 KPIs
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b004

	measure 'Alterações Registradas' = COUNTROWS('historicoAlteracoes')
		formatString: #,##0
		displayFolder: 01 KPIs
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b005

	measure 'Instrumentos por Data' = COUNTROWS('instrumentos')
		formatString: #,##0
		displayFolder: 03 Tendencias
		lineageTag: 1d4a8f26-1f63-4e2a-8f3f-5c17b6f2b006

	measure 'Vencem em até 30 dias' =
			CALCULATE (
			    COUNTROWS ( 'instrumentos' ),
			    'instrumentos'[Dias para vencer] >= 0 && 'instrumentos'[Dias para vencer] <= 30
			)
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10101

	measure 'Vencem em 31 a 90 dias' =
			CALCULATE (
			    COUNTROWS ( 'instrumentos' ),
			    'instrumentos'[Dias para vencer] > 30 && 'instrumentos'[Dias para vencer] <= 90
			)
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10102

	measure 'Vencem em até 90 dias' = [Vencem em até 30 dias] + [Vencem em 31 a 90 dias]
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10103

	measure 'Instrumentos encerrados' = CALCULATE ( COUNTROWS ( 'instrumentos' ), 'instrumentos'[Dias para vencer] < 0 )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10104

	measure 'Sem data de término' = CALCULATE ( COUNTROWS ( 'instrumentos' ), ISBLANK ( 'instrumentos'[dataFimVigenciaEfetiva] ) )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10105

	measure 'Aditivos nos últimos 12 meses' =
			VAR _inicio = EDATE ( TODAY (), -12 )
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'aditivos' ),
			        'aditivos'[dataAssinaturaAditivo] > _inicio
			    )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10106

	measure 'Aditivos de prazo' = CALCULATE ( COUNTROWS ( 'aditivos' ), 'aditivos'[alteraVigencia] = TRUE () )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10107

	measure 'Partícipes ativos' = CALCULATE ( COUNTROWS ( 'participes' ), 'participes'[ativo] = TRUE () )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10108

	measure 'Instrumentos do partícipe' = DISTINCTCOUNT ( 'participesInstrumentos'[idInstrumento.lookupValue] )
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10109

	measure 'Prazo médio de vigência (meses)' =
			AVERAGEX (
			    FILTER (
			        'instrumentos',
			        NOT ISBLANK ( 'instrumentos'[dataInicioVigenciaTermo] )
			            && NOT ISBLANK ( 'instrumentos'[dataFimVigenciaEfetiva] )
			    ),
			    DATEDIFF ( 'instrumentos'[dataInicioVigenciaTermo], 'instrumentos'[dataFimVigenciaEfetiva], MONTH )
			)
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10110

	measure 'Destaque CGPRES' =
			VAR _ate30 = [Vencem em até 30 dias] + 0
			VAR _ate90 = [Vencem em 31 a 90 dias] + 0
			VAR _txt30 =
			    FORMAT ( _ate30, "0" )
			        & IF ( _ate30 = 1, " instrumento vence", " instrumentos vencem" )
			        & " em até 30 dias"
			VAR _txt90 =
			    FORMAT ( _ate90, "0" ) & " entre 31 e 90 dias"
			RETURN
			    SWITCH (
			        TRUE (),
			        _ate30 + _ate90 = 0, "Nenhum instrumento vence nos próximos 90 dias.",
			        _ate90 = 0, _txt30 & ".",
			        _ate30 = 0, "Nenhum instrumento vence em até 30 dias; " & _txt90 & ".",
			        _txt30 & " e " & _txt90 & "."
			    )
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10111

	measure 'Próximo vencimento' =
			VAR _futuros =
			    FILTER ( 'instrumentos', 'instrumentos'[Dias para vencer] >= 0 )
			VAR _proximo =
			    TOPN ( 1, _futuros, 'instrumentos'[Dias para vencer], ASC )
			VAR _dias = MINX ( _proximo, 'instrumentos'[Dias para vencer] )
			VAR _processo = MAXX ( _proximo, 'instrumentos'[numeroProcesso] )
			VAR _data = MINX ( _proximo, 'instrumentos'[dataFimVigenciaEfetiva] )
			RETURN
			    IF (
			        ISBLANK ( _dias ),
			        "Sem vencimentos futuros no filtro atual.",
			        "Próximo vencimento: processo " & _processo & ", em "
			            & FORMAT ( _dias, "0" ) & IF ( _dias = 1, " dia", " dias" )
			            & " (" & FORMAT ( _data, "dd/mm/yyyy" ) & ")."
			    )
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10112

	measure 'Atualização dos dados' =
			VAR _ultima =
			    CALCULATE ( MAX ( 'instrumentos'[Modificado] ), REMOVEFILTERS ( 'instrumentos' ) )
			RETURN
			    "Última alteração registrada em " & FORMAT ( _ultima, "dd/mm/yyyy" )
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10113

	measure 'Cor do prazo' =
			VAR _d = MIN ( 'instrumentos'[Dias para vencer] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _d ), "#5F6368",
			        _d < 0, "#5F6368",
			        _d <= 30, "#B42318",
			        _d <= 90, "#92400E",
			        "#111827"
			    )
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10114

	measure 'Vencimentos nos próximos 12 meses' =
			CALCULATE (
			    COUNTROWS ( 'instrumentos' ),
			    'instrumentos'[Dias para vencer] >= 0 && 'instrumentos'[Dias para vencer] <= 365
			)
		formatString: #,##0
		displayFolder: CGPRES
		lineageTag: 7c1e0a51-3b2d-4f6e-9a10-c6e5a0b10115
